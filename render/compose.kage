//kage:unit pixels

package main

// Sun is the way towards the sun, Toward the way towards the eye; Glint holds the time in seconds
// and the sun's strength, for what glints in it; SunColor, SkyColor and Ambience are the colours of
// the sun, of the sky and of the light every surface gets from it.
var Sun vec3
var Toward vec3
var Glint vec4
var SunColor vec3
var SkyColor vec3
var Ambience vec3

// Wind blows in world units a second, Drift is how far it has carried the clouds; Weather holds
// how much of the sky the clouds cover, 0 to 1.
var Wind vec2
var Drift vec2
var Weather vec4

// Fragment is the sheet's texel times the vertex colour, faded or outlined at the edges an item
// asks for. Per edge, custom holds 1 plus the distance to it in units of its fade (the piece fades
// out there), minus 1 minus the distance in pixels (the piece is outlined there), or 0 (nothing).
// A glint's vertex (alpha over 1.5) holds its shine in red, where it lies in the world in green and
// blue, 2 plus how much of the sun reaches it in alpha and its shore in custom: the sky it reflects
// and the surf's foam are laid over the tile under it, the sun it throws back added.
// The clouds' shadow on the ground (alpha over 3.5) holds where it lies in green and blue: it
// darkens the tile under it as much as the clouds over it take of the sun.
func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	if color.a > 3.5 {
		shadow := cloudDark * clouds(color.gb) * clamp(Glint.y*1.4, 0, 1)
		return vec4(0, 0, 0, shadow)
	}
	if color.a > 1.5 {
		shine, lit := color.r, color.a-2
		s := sea(color.gb, custom)
		mirror, foam := shine*s.z, s.y
		lit *= 1 - clouds(color.gb)
		light := Ambience + SunColor*(Glint.y*lit*max(sunWay().z, 0))
		rgb := overcastSky()*mirror*(1-foam) + light*foam + SunColor*(shine*lit*s.x)
		return vec4(rgb, 1-(1-mirror)*(1-foam))
	}
	faded := step(0.5, custom)
	ramp := smoothstep(0, 1, clamp(custom-1, 0, 1))
	f := mix(vec4(1), ramp, faded)

	outlined := step(custom, vec4(-0.5))
	near := outlined * (1 - smoothstep(0, 1, clamp(-custom-1, 0, 1)))
	edge := max(max(near.x, near.y), max(near.z, near.w))

	c := imageSrc0At(src) * color * f.x * f.y * f.z * f.w
	return vec4(c.rgb*(1-outlineDark*edge), c.a)
}

// sea is, for water at p, the sun thrown back at the eye, how much foam covers it and how much of
// the sky it reflects. Waves run across it as time goes by; near a shore (the way to it, how far
// and how near) a swell comes in facing it and breaks into foam the last stretch before it,
// whatever the sun. The flatter the eye looks at a wave, the more of the sky it reflects.
func sea(p vec2, shore vec4) vec3 {
	t := Glint.x
	// the waves run with the wind, the steeper the harder it blows
	blow := length(Wind)
	rough := clamp(calmSea+blow/fullWind, calmSea, stormSea)
	way := vec2(1, 0)
	if blow > 0.01 {
		way = Wind / blow
	}
	q := vec2(way.x*p.x+way.y*p.y, way.x*p.y-way.y*p.x) // p along the wind and across it
	slope := wave(q, vec2(1, 0.1), 53, 10, t)
	slope += wave(q, vec2(0.3, 1), 41, 9, t)
	slope += wave(q, vec2(-0.8, 0.6), 31, 8, t)
	slope += wave(q, vec2(-0.6, -0.8), 23, 7, t)
	slope += wave(q, vec2(0.7, -0.7), 17, 6, t)
	slope += wave(q, vec2(1, 0.8), 13, 5, t)
	slope += wave(q, vec2(-0.2, 1), 9, 4, t)
	slope = rough * vec2(way.x*slope.x-way.y*slope.y, way.y*slope.x+way.x*slope.y)
	foam := 0.0
	if way := length(shore.xy); way > 0.01 {
		// the crests follow the shore: their phase is the distance to it, falling as they come in,
		// shifted slowly along the coast so they do not reach it everywhere at once
		d := shore.xy / way
		drift := 2 * pi * (sin(p.x/173+p.y/241) + 0.5*sin(p.y/97-p.x/131))
		phase := 2*pi/swellLength*(shore.z+swellSpeed*t) + drift
		swell := d * (rough * swellSlope * cos(phase))
		swell += d * (rough * swellSlope * 0.5 * cos(2.2*phase+1))
		near := smoothstep(0, 1, clamp(shore.w, 0, 1))
		slope = mix(slope, swell+slope*0.3, near)
		// a crest breaks the last surfWidth before the shore, torn into patches
		crest := smoothstep(0.2, 1, sin(phase))
		breaking := 1 - smoothstep(0, surfWidth, shore.z)
		torn := 0.6 + 0.4*sin(p.x*0.37+p.y*0.23+t)*sin(p.y*0.41-p.x*0.19-t*0.7)
		foam = foamCover * crest * breaking * torn * clamp(rough, 0.3, 1.2)
	}
	n := normalize(vec3(-slope.x, -slope.y, 1))
	h := normalize(sunWay() + Toward)
	// the sky seen in the water follows only the swell of the waves, not every ripple: fine waves
	// flattened far off would stripe it
	calm := normalize(vec3(-slope.x*mirrorSwell, -slope.y*mirrorSwell, 1))
	fresnel := mirrorHead + (1-mirrorHead)*pow(1-max(dot(calm, Toward), 0), 5)
	return vec3(Glint.y*pow(max(dot(n, h), 0), glintSharpness), clamp(foam, 0, 1), fresnel)
}

// overcastSky is the sky's colour under the clouds covering it, as render.Overcast has it.
func overcastSky() vec3 {
	grey := dot(SkyColor, vec3(0.3, 0.5, 0.2)) * 0.85
	return mix(SkyColor, vec3(grey), clamp(Weather.x, 0, 1)*0.8)
}

// sunWay is the way towards the sun, of length 1.
func sunWay() vec3 {
	return Sun / max(length(Sun), 1e-6)
}

// clouds is how thick the clouds are over the ground at p: 0 in the clear, 1 under the thickest,
// drifting with the wind. Their shadow falls straight under them: they are not drawn, only their
// shadows, and a shadow cast off them towards the sun would jump whenever the sun steps on.
func clouds(p vec2) float {
	cover := Weather.x
	if cover <= 0 {
		return 0
	}
	q := (p - Drift) / cloudSize
	n := (noise(q) + 0.5*noise(q*2.03+17) + 0.25*noise(q*4.01+31) + 0.125*noise(q*8.07+53)) / 1.875
	n = clamp((n-0.5)*cloudContrast+0.5, 0, 1) // the sum bunches round a half: spread it out
	return smoothstep(1-cover, 1.15-cover, n)
}

// noise is smooth value noise at p: 0 to 1, changing over a unit.
func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3 - 2*f)
	a := hash(i)
	b := hash(i + vec2(1, 0))
	c := hash(i + vec2(0, 1))
	d := hash(i + vec2(1, 1))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// hash is a number 0 to 1 fixed for the whole point i.
func hash(i vec2) float {
	return fract(sin(dot(i, vec2(127.1, 311.7))) * 43758.5453)
}

// wave is the slope at p of a wave running along way, length world units from crest to crest, at
// speed world units a second.
func wave(p vec2, way vec2, length float, speed float, t float) vec2 {
	d := normalize(way)
	k := 2 * pi / length
	return d * (waveSlope * cos(k*(dot(p, d)-speed*t)))
}

// outlineDark is how much an outline darkens what it is drawn on.
const outlineDark = 0.45

// waveSlope is how steep a wave's side gets; glintSharpness how narrowly a glint gathers round the
// perfect reflection.
const waveSlope = 0.12
const glintSharpness = 400

// The swell coming ashore: how steep, how long from crest to crest and how fast, in world units.
const swellSlope = 0.3
const swellLength = 40
const swellSpeed = 12

// surfWidth is how far from the shore, in world units, a crest breaks; foamCover how much of the
// water its foam covers at most.
const surfWidth = 32
const foamCover = 0.9

// mirrorHead is how much of the sky water reflects looked at straight down; flatter it reflects
// more, all of it along the surface.
const mirrorHead = 0.02

// mirrorSwell is how much of the waves' slope tilts the sky water reflects.
const mirrorSwell = 0.3

// The weather: how wide a cloud is, in world units; how much of the sun's light the thickest
// takes; how far the noise is spread to make clouds and clear sky between them.
const cloudSize = 420
const cloudDark = 0.5
const cloudContrast = 1.8

// How rough the sea is: calm with no wind, as the waves were made at fullWind (world units a
// second), and at most stormSea times that.
const calmSea = 0.35
const fullWind = 40
const stormSea = 1.8

const pi = 3.14159265
