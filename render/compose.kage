//kage:unit pixels

package main

// The frame's daylight: Sun is the way towards the sun, Toward the way towards the eye; Glint holds
// the time in seconds, the sun's strength and how many world units a pixel spans; SunColor,
// SkyColor and Ambience are the colours of the sun, of the sky and of the light every surface gets
// from it.
var Sun vec3
var Toward vec3
var Glint vec4
var SunColor vec3
var SkyColor vec3
var Ambience vec3

// The frame's weather: Wind blows in world units a second, Drift is how far it has carried the
// clouds; Weather holds how much of the sky the clouds cover, 0 to 1.
var Wind vec2
var Drift vec2
var Weather vec4

// Fragment is the sheet's texel times the vertex colour, faded or outlined at the edges an item
// asks for. Per edge, custom holds 1 plus the distance to it in units of its fade (the piece fades
// out there), minus 1 minus the distance in pixels (the piece is outlined there), or 0 (nothing).
// A blended sprite (the last custom over 50000, 100000 plus how soft; a fade's stays under 10000)
// holds its weight in alpha: it shows
// where the weight is over a half, glazed as far as 1 plus its opacity in the third custom says. An overlay (alpha over 1.5, 2 plus twice its material's number
// plus a fraction 0 to 1 it reads) is its material's to work out: where it lies in the world in
// green and blue, what the material reads in red, the fraction and custom — see material.
func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	if color.a > 1.5 {
		k := floor((color.a - 2) / 2)
		return material(k, color.gb, color.r, color.a-2-2*k, custom)
	}
	if custom.w > 50000 {
		// a blended sprite: shown where its weight is over a half, fading in round it, as far as
		// its opacity (1 plus it in the third custom) where it glazes
		a := blended(color.a, custom.w)
		if custom.z > 0.5 {
			a *= custom.z - 1
		}
		c := imageSrc0At(src)
		return vec4(c.rgb*color.rgb*a, c.a*a)
	}
	f := faded(custom)
	outlined := step(custom, vec4(-0.5))
	near := outlined * (1 - smoothstep(0, 1, clamp(-custom-1, 0, 1)))
	edge := max(max(near.x, near.y), max(near.z, near.w))

	c := imageSrc0At(src) * color * f
	return vec4(c.rgb*(1-outlineDark*edge), c.a)
}

// faded is how much of a sprite shows by the fades its custom asks for: 1 where it asks none.
func faded(custom vec4) float {
	f := mix(vec4(1), smoothstep(0, 1, clamp(custom-1, 0, 1)), step(0.5, custom))
	return f.x * f.y * f.z * f.w
}

// blended is how much of a blended sprite shows at weight, its mark 100000 plus how soft it is.
func blended(weight float, mark float) float {
	soft := mark - 100000
	return smoothstep(0.5-soft, 0.5+soft, weight)
}

// sunWay is the way towards the sun, of length 1.
func sunWay() vec3 {
	return Sun / max(length(Sun), 1e-6)
}

// noise is smooth value noise at p: 0 to 1, changing over a unit.
func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3 - 2*f)
	a := hash(i)
	b := hash(i + vec2(1, 0))
	c := hash(i + vec2(0, 1))
	d := hash(i + vec2(1, 1))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// hash is a number 0 to 1 fixed for the whole point i.
func hash(i vec2) float {
	return fract(sin(dot(i, vec2(127.1, 311.7))) * 43758.5453)
}

// seen is how much of a pattern length world units long shows: all of it over a few pixels long,
// none of it where it would flicker, finer than a pixel or two.
func seen(length float) float {
	return smoothstep(finest, 2*finest, length/max(Glint.z, 1e-3))
}

// outlineDark is how much an outline darkens what it is drawn on.
const outlineDark = 0.45

// finest is how many pixels long the finest pattern drawn is.
const finest = 2

const pi = 3.14159265


// The materials registered follow, and material, which hands an overlay to its own.
