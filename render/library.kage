//kage:unit pixels

package main

// The library of the composer's shader and of every shader built on it (ShaderSourceWith): the
// composer's own uniforms — Toward is the way towards the eye, Clock the time in seconds, Pixel how
// many world units a pixel spans, Fog the colour what lies far off in the air turns to — and the
// helpers the materials call. Every other uniform is a material's, declared in its own source
// (render.RegisterMaterials) and set by a source with render.Frame.Uniform.
var Toward vec3
var Clock float
var Pixel float
var Fog vec3

// faded is how much of a sprite shows by the fades its custom asks for: 1 where it asks none.
func faded(custom vec4) float {
	f := mix(vec4(1), smoothstep(0, 1, clamp(custom-1, 0, 1)), step(0.5, custom))
	return f.x * f.y * f.z * f.w
}

// blended is how much of a blended sprite shows at weight, its mark 100000 plus how soft it is.
func blended(weight float, mark float) float {
	soft := mark - 100000
	return smoothstep(0.5-soft, 0.5+soft, weight)
}

// noise is smooth value noise at p: 0 to 1, changing over a unit.
func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3 - 2*f)
	a := hash(i)
	b := hash(i + vec2(1, 0))
	c := hash(i + vec2(0, 1))
	d := hash(i + vec2(1, 1))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// hash is a number 0 to 1 fixed for the whole point i.
func hash(i vec2) float {
	return fract(sin(dot(i, vec2(127.1, 311.7))) * 43758.5453)
}

// seen is how much of a pattern length world units long shows: all of it over a few pixels long,
// none of it where it would flicker, finer than a pixel or two.
func seen(length float) float {
	return smoothstep(finest, 2*finest, length/max(Pixel, 1e-3))
}

// outlineDark is how much an outline darkens what it is drawn on.
const outlineDark = 0.45

// finest is how many pixels long the finest pattern drawn is.
const finest = 2

const pi = 3.14159265

