# Go build cache / artifacts
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled example binaries `go build ./examples/...` (or `go build ./...`)
# drops at repo root, named after the package directory (e.g.
# board-navigation-demo, collision-demo) — every real root-level file has an
# extension or is one of the handful excepted below, so exclude by that
# instead of naming each example.
/*
!/*.*
!/*/
!/Makefile
!/LICENSE

# Test binaries
*.test

# Go temporary build output
*.out

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# asdf
.tool-versions

# gram save files
*.game.save
*.game.*.save

# codecov
coverage.txt

# Raw benchmark output of make bench-save
bench_results/

# A worktree's workspace file, which the root rule above would otherwise keep
go.work
go.work.sum
