// The sun over the world, in the composer's shader: Sun is the way towards it, SunStrength how
// much it lights a surface facing it square on, SunColor and SkyColor the colours of its light and
// of the sky, Ambience the light every surface gets from the sky. sky.Sun.Frame sets them.
var Sun vec3
var SunStrength float
var SunColor vec3
var SkyColor vec3
var Ambience vec3

// sunWay is the way towards the sun, of length 1.
func sunWay() vec3 {
	return Sun / max(length(Sun), 1e-6)
}
