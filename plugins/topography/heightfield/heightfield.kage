// The ground traced on the GPU (topography/heightfield), after the composer's library and every
// material (render.ShaderSourceWith): the sun (Sun, sunWay, SunStrength, SunColor, Ambience), the
// air (Fog, Visibility, Cover, Drift, Wind), the clock and a world unit a pixel spans (Pixel) come
// from them, and the water is the topography's materials (SeaGlint, RunningWater).

// The lines of sight (camera.RayField): the ray through the screen pixel (x, y), handed in the
// custom values, starts at Origin + x·DX + y·DY and runs along Dir + x·DDX + y·DDY; Bend is how far
// under the eye's level the ground d off is drawn, per d².
var Origin vec3
var DX vec3
var DY vec3
var Dir vec3
var DDX vec3
var DDY vec3
var Bend float

// The lattice, Corners.x by Corners.y corners a Cell apart, in the first image's four quadrants of
// that size: the heights top-left, Low up to Low+Span in red and green as 16 bits; the way the
// ground faces top-right as (n+1)/2; each cell's highest corner bottom-left, as the heights; the
// way to the shore bottom-right, (dir+1)/2 in red and green, the distance over ShoreReach in blue.
// Every image is read at a position in the first one's texture (Ebitengine's imageSrcNAt): its
// origin and the pixel.
var Cell float
var Corners vec2
var Low float
var Span float
var ShoreReach float

// The board painted flat, the second image, Px pixels a cell and AlbedoSize pixels in all; its
// water, the third, WaterPx pixels a cell in quadrants of the cells' size (heightfield.WaterLayers),
// the flows over FlowSpan; none where WaterPx is 0.
var Px float
var AlbedoSize vec2
var WaterPx float
var FlowSpan float

// Shadows over a half casts the terrain's shadows; GridFrom is how many screen pixels a cell must
// span for the grid to show, 0 none; Trace is how many screen pixels a traced one spans.
var Shadows float
var GridFrom float
var Trace float

// How many cells a line of sight walks at most, how many steps of three quarters of a cell a line
// towards the sun takes, and how wide the shadows' penumbra is per unit towards the sun: a cone
// of about 4.6°.
const cells = 320
const shadowSteps = 16
const shadowSoft = 0.08

// height is the ground's height at the world point p as a tile is drawn: two flat triangles split
// along the diagonal whose corners stand nearer in height (topography.Relief.GroundAt).
func height(p vec2) float {
	g := clamp(p/Cell, vec2(0), Corners-1.0001)
	i := floor(g)
	return drawn(g-i, corner(i), corner(i+vec2(1, 0)), corner(i+vec2(0, 1)), corner(i+vec2(1, 1)))
}

// drawn is the height at f, 0 to 1 across and down a cell whose corners stand at h0 to h3, as the
// cell is drawn: two flat triangles split along the diagonal whose corners stand nearer.
func drawn(f vec2, h0, h1, h2, h3 float) float {
	if abs(h0-h3) < abs(h1-h2) {
		if f.x >= f.y {
			return h0 + f.x*(h1-h0) + f.y*(h3-h1)
		}
		return h0 + f.y*(h2-h0) + f.x*(h3-h2)
	}
	if f.x+f.y <= 1 {
		return h0 + f.x*(h1-h0) + f.y*(h2-h0)
	}
	return h3 + (1-f.x)*(h2-h3) + (1-f.y)*(h1-h3)
}

// cellTop is the highest corner of the cell whose top-left corner is i, from the lattice's
// bottom-left quadrant, rounded up: nothing of the cell stands over it.
func cellTop(i vec2) float {
	c := imageSrc0At(imageSrc0Origin() + vec2(0, Corners.y) + i + 0.5)
	return Low + (c.r*255*256+c.g*255)/65535*Span
}

// corner is the height at the lattice corner i, decoded from 16 bits of the lattice's top-left
// quadrant.
func corner(i vec2) float {
	c := imageSrc0At(imageSrc0Origin() + i + 0.5)
	return Low + (c.r*255*256+c.g*255)/65535*Span
}

// above is how far the line of sight o + d·t runs over the ground at t in the cell whose corners
// stand at h0 to h3, q being o in the cell's parts and v a step of d: the ground sunk by the Bend
// as far off as it lies.
func above(o vec3, d vec3, t float, q vec2, v vec2, h0, h1, h2, h3 float) float {
	f := clamp(q+v*t, vec2(0), vec2(1))
	off := d.xy * t
	return o.z + d.z*t - drawn(f, h0, h1, h2, h3) + Bend*dot(off, off)
}

// ground is the ground under the point p as the eye sees it: sunk by the Bend as far off as it
// lies from where the rays start.
func ground(p vec3) float {
	d := p.xy - Origin.xy
	return height(p.xy) - Bend*dot(d, d)
}

// cornerNormal is the way the ground faces at the lattice corner i, from the lattice's top-right
// quadrant.
func cornerNormal(i vec2) vec3 {
	return imageSrc0At(imageSrc0Origin()+vec2(Corners.x, 0)+i+0.5).rgb*2 - 1
}

// cornerShore is the way to the shore from the lattice corner i, its x and y, and how far it is.
func cornerShore(i vec2) vec3 {
	c := imageSrc0At(imageSrc0Origin() + Corners + i + 0.5)
	return vec3(c.r*2-1, c.g*2-1, c.b*ShoreReach)
}

// shoreAt is the way to the shore from p, blended between the corners of its cell as the tiles'
// glint blends it: its x and y, how far and how near, as SeaGlint takes it.
func shoreAt(p vec2) vec4 {
	g := clamp(p/Cell, vec2(0), Corners-1.0001)
	i := floor(g)
	f := g - i
	top := mix(cornerShore(i), cornerShore(i+vec2(1, 0)), f.x)
	bottom := mix(cornerShore(i+vec2(0, 1)), cornerShore(i+vec2(1, 1)), f.x)
	s := mix(top, bottom, f.y)
	return vec4(s.x, s.y, s.z, 1-s.z/ShoreReach)
}

// waterAt is the water's layer q (its quadrant, 0 or 1 across and down) at p, blended between the
// four pixels round it.
func waterAt(p vec2, q vec2) vec3 {
	size := (Corners - 1) * WaterPx
	t := clamp(p/Cell*WaterPx-0.5, vec2(0), size-1.0001)
	i := floor(t)
	f := t - i
	o := imageSrc0Origin() + q*size + i + 0.5
	top := mix(imageSrc2At(o).rgb, imageSrc2At(o+vec2(1, 0)).rgb, f.x)
	bottom := mix(imageSrc2At(o+vec2(0, 1)).rgb, imageSrc2At(o+vec2(1, 1)).rgb, f.x)
	return mix(top, bottom, f.y)
}

// over is c laid over what is under it: a premultiplied colour, as the composer lays an overlay.
func over(c vec4, under vec3) vec3 {
	return c.rgb + under*(1-c.a)
}

// normal is the way the ground faces at p: the corners' ways blended across the cell, so the
// light runs on smoothly from cell to cell as it does over the tiles.
func normal(p vec2) vec3 {
	g := clamp(p/Cell, vec2(0), Corners-1.0001)
	i := floor(g)
	f := g - i
	top := mix(cornerNormal(i), cornerNormal(i+vec2(1, 0)), f.x)
	bottom := mix(cornerNormal(i+vec2(0, 1)), cornerNormal(i+vec2(1, 1)), f.x)
	return normalize(mix(top, bottom, f.y))
}

// albedo is the board's colour at the world point p: blended between the four pixels of the
// board painted flat round it, one picture over the whole board, so a way runs on across the
// cells' borders.
func albedo(p vec2) vec3 {
	t := clamp(p/Cell*Px-0.5, vec2(0), max(AlbedoSize-1.0001, vec2(0)))
	i := floor(t)
	f := t - i
	o := imageSrc0Origin() + i + 0.5
	top := mix(imageSrc1At(o).rgb, imageSrc1At(o+vec2(1, 0)).rgb, f.x)
	bottom := mix(imageSrc1At(o+vec2(0, 1)).rgb, imageSrc1At(o+vec2(1, 1)).rgb, f.x)
	return mix(top, bottom, f.y)
}

// sunlit is how much of the sun, the way sun, reaches p: none where the ground towards the sun
// rises over the line to it within shadowSteps steps, fading in over the penumbra — the clearance
// over the ground against how far along the line it is, so level ground stays lit under a low
// sun.
func sunlit(p vec3, sun vec3) float {
	if Shadows < 0.5 || sun.z <= 0 {
		return 1
	}
	step := Cell * 0.75
	top := Low + Span
	lit := 1.0
	for k := 1; k <= shadowSteps; k++ {
		t := step * float(k)
		q := p + sun*t
		if q.z > top {
			break
		}
		clearance := q.z - height(q.xy)
		if clearance < 0 {
			return 0
		}
		lit = min(lit, clearance/(t*shadowSoft))
	}
	return lit
}

// sway is how far p moves over the ground plane of normal n when the screen pixel moves by one
// along x — dO, dD the way its line of sight's start and way move — the line of sight O + D·T
// meeting the plane at T.
func sway(n vec3, o vec3, d vec3, t float, dO vec3, dD vec3) vec3 {
	return dO + dD*t - d*(dot(n, dO)+t*dot(n, dD))/dot(n, d)
}

// edge is how dark the grid is at p, 0 to 1: full on a cell's edge, fading out over a traced
// pixel, px and py how far p moves over the ground for a screen pixel across and down.
func edge(p vec2, px vec3, py vec3) float {
	g := p / Cell
	f := min(fract(g), 1-fract(g)) * Cell // how far from the edges along x and y, in world units
	rate := vec2(length(vec2(px.x, py.x)), length(vec2(px.y, py.y)))
	pixels := f / max(rate, vec2(1e-6)) // in screen pixels
	return 1 - smoothstep(0, 0.75*Trace, min(pixels.x, pixels.y))
}

// Fragment traces the pixel's line of sight over the ground: nothing where it misses, else the
// cell's colour there in the sun's light, turned to the Fog as far off as it lies.
func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	px := custom.xy
	o := Origin + DX*px.x + DY*px.y
	d := normalize(Dir + DDX*px.x + DDY*px.y)
	size := (Corners - 1) * Cell
	top := Low + Span
	// where the ray enters the box over the lattice, and leaves it
	tmin := 0.0
	tmax := 1.0e9
	if abs(d.z) > 1.0e-6 {
		ta := (top - o.z) / d.z
		if d.z > 0 {
			tmax = min(tmax, ta) // going up: gone once over the top; never in it from over it
		} else {
			tmin = max(tmin, ta) // coming down: in from over the top, else from where it starts
		}
	} else if o.z > top {
		return vec4(0)
	}
	if abs(d.x) > 1.0e-6 {
		ta := (0 - o.x) / d.x
		tb := (size.x - o.x) / d.x
		tmin = max(tmin, min(ta, tb))
		tmax = min(tmax, max(ta, tb))
	} else if o.x < 0 || o.x > size.x {
		return vec4(0)
	}
	if abs(d.y) > 1.0e-6 {
		ta := (0 - o.y) / d.y
		tb := (size.y - o.y) / d.y
		tmin = max(tmin, min(ta, tb))
		tmax = min(tmax, max(ta, tb))
	} else if o.y < 0 || o.y > size.y {
		return vec4(0)
	}
	if tmin > tmax {
		return vec4(0)
	}
	// the line walks the lattice cell by cell (a grid walk), passing over a cell whose highest
	// corner it stays above and meeting the two triangles of any other exactly: the height over
	// the ground is straight along the line within a triangle, so where it changes sign the line
	// meets the ground
	t := tmin
	i := clamp(floor((o.xy+d.xy*t)/Cell), vec2(0), Corners-2)
	walk := sign(d.xy)
	// a boundary never met lies past the farthest the line runs (tmax); a literal much larger
	// does not survive the shader's compiling as the number it is
	tx := 2.0e9
	dtx := 2.0e9
	if abs(d.x) > 1.0e-9 {
		tx = ((i.x+max(walk.x, 0))*Cell - o.x) / d.x
		dtx = Cell / abs(d.x)
	}
	ty := 2.0e9
	dty := 2.0e9
	if abs(d.y) > 1.0e-9 {
		ty = ((i.y+max(walk.y, 0))*Cell - o.y) / d.y
		dty = Cell / abs(d.y)
	}
	hit := false
	th := t
	for k := 0; k < cells; k++ {
		t1 := min(min(tx, ty), tmax)
		if min(o.z+d.z*t, o.z+d.z*t1) <= cellTop(i) {
			h0 := corner(i)
			h1 := corner(i + vec2(1, 0))
			h2 := corner(i + vec2(0, 1))
			h3 := corner(i + vec2(1, 1))
			q := o.xy/Cell - i
			v := d.xy / Cell
			// where the line crosses the diagonal the cell is split along
			tm := -1.0
			if abs(h0-h3) < abs(h1-h2) {
				if abs(v.x-v.y) > 1.0e-9 {
					tm = (q.y - q.x) / (v.x - v.y)
				}
			} else if abs(v.x+v.y) > 1.0e-9 {
				tm = (1 - q.x - q.y) / (v.x + v.y)
			}
			ta := t
			fa := above(o, d, ta, q, v, h0, h1, h2, h3)
			if fa <= 0 {
				hit = true
				th = ta
				break
			}
			if tm > t && tm < t1 {
				fm := above(o, d, tm, q, v, h0, h1, h2, h3)
				if fm <= 0 {
					hit = true
					th = ta + (tm-ta)*fa/(fa-fm)
					break
				}
				ta = tm
				fa = fm
			}
			f1 := above(o, d, t1, q, v, h0, h1, h2, h3)
			if f1 <= 0 {
				hit = true
				th = ta + (t1-ta)*fa/(fa-f1)
				break
			}
		}
		if t1 >= tmax {
			break
		}
		if tx < ty {
			i.x += walk.x
			t = tx
			tx += dtx
		} else {
			i.y += walk.y
			t = ty
			ty += dty
		}
		if i.x < 0 || i.y < 0 || i.x > Corners.x-2 || i.y > Corners.y-2 {
			break
		}
	}
	if !hit {
		return vec4(0)
	}
	t = th
	p := o + d*t
	n := normal(p.xy)
	sun := sunWay()
	lit := 0.0
	if sun.z > 0 {
		lit = sunlit(vec3(p.xy, height(p.xy)), sun)
	}
	rgb := albedo(p.xy) * (Ambience + SunColor*max(dot(n, sun), 0)*lit*SunStrength)
	// how far p moves over the ground for a screen pixel, and how many a cell spans there
	D := Dir + DDX*px.x + DDY*px.y
	O := Origin + DX*px.x + DY*px.y
	T := dot(n, p-O) / dot(n, D)
	moveX := sway(n, O, D, T, DX, DDX)
	moveY := sway(n, O, D, T, DY, DDY)
	span := Cell / max(min(length(moveX.xy), length(moveY.xy)), 1e-6)
	cover := 0.0
	if Cover > 0 {
		cover = cloudCover(cloudField(p.xy))
	}
	wet := lit * (1 - cover) // the sun on the water, the clouds' shadow taken off
	detail := clamp((span-6)/6, 0, 1)
	var run vec3
	var still vec3
	var mouth vec3
	if WaterPx > 0 {
		run = waterAt(p.xy, vec2(0, 0))
		still = waterAt(p.xy, vec2(1, 0))
		mouth = waterAt(p.xy, vec2(0, 1))
	}
	// the sea's glint, the waves turning to the shore and breaking on it near enough
	if still.b > 0.004 && detail > 0 {
		shore := vec4(0)
		if span >= 16 {
			shore = shoreAt(p.xy)
		}
		rgb = over(SeaGlint(p.xy, still.g/still.b*detail, wet, shore)*still.b, rgb)
	}
	if cover > 0 {
		rgb *= 1 - cloudShade(cover)
	}
	if GridFrom > 0 && span >= GridFrom {
		rgb *= 1 - outlineDark*edge(p.xy, moveX, moveY)
	}
	// the water running down the ways and the cells it runs over, and where a way turns into water
	if run.b > 0.004 && span > 16 {
		v := (run.rg/run.b*2 - 1) * FlowSpan
		rgb = over(RunningWater(p.xy, still.r/run.b*clamp((span-16)/8, 0, 1), wet, vec4(v, 0, 0))*run.b, rgb)
	}
	if mouth.g > 0.004 && detail > 0 {
		rgb = over(SeaGlint(p.xy, mouth.r/mouth.g*detail, wet, vec4(0))*mouth.g, rgb)
	}
	if Visibility > 0 {
		rgb = mix(rgb, Fog, 1-exp(-t/Visibility))
	}
	return vec4(rgb, 1)
}
